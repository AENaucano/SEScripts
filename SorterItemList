public void Main(string argument) {
    // Find your sorter
    IMyConveyorSorter sorter = GridTerminalSystem.GetBlockWithName("My Sorter") as IMyConveyorSorter;

    if (sorter != null) {
        // Create a list to hold the filters
        List<MyInventoryItemFilter> currentFilters = new List<MyInventoryItemFilter>();
        
        // Populate the list
        sorter.GetFilterList(currentFilters);

        // Access the items
        foreach (var filter in currentFilters) {
            string itemName = filter.ItemId.ToString();
            Echo($"Filtering: {itemName}");
        }
    }
}
//////////////////////////// usable as function
public List<MyInventoryItemFilter> GetSorterFilters(string sorterName)
{
    IMyConveyorSorter sorter = GridTerminalSystem.GetBlockWithName(sorterName) as IMyConveyorSorter;
    List<MyInventoryItemFilter> filters = new List<MyInventoryItemFilter>();

    // 3. If the sorter exists, populate the list using GetFilterList
    if (sorter != null) {
        sorter.GetFilterList(filters);
    }
    else
    {
      Echo "Sorter " + sorterName + " not found!\n"; // or any logging system
    }
    if (!filters.Any()) Echo sorterName + " List is Empty \n"; // or any logging system

    // 4. Return the list (will be empty if sorter wasn't found or had no filters)
    return filters;
}
///////////////////////////// comparing Cargo/filter
public void Main(string argument) {
    // 1. Get the filters from your sorter
    List<MyInventoryItemFilter> sorterFilters = GetSorterFilters("My Sorter Name");
    
    // 2. Get the cargo container's inventory
    IMyCargoContainer cargo = GridTerminalSystem.GetBlockWithName("My Cargo") as IMyCargoContainer;
    if (cargo == null) return;
    IMyInventory inventory = cargo.GetInventory();

    // 3. Get the list of all items currently in that cargo container
    List<MyInventoryItem> cargoItems = new List<MyInventoryItem>();
    inventory.GetItems(cargoItems);

    // 4. Compare items
    foreach (var item in cargoItems) {
        // Check if this item is in the sorter's filter list
        bool isFiltered = sorterFilters.Any(f => f.ItemId == item.Type);
        
        if (isFiltered) {
            Echo($"MATCH: {item.Type.SubtypeId} is in the filter list.");
        } else {
            Echo($"NO MATCH: {item.Type.SubtypeId} is NOT in the filter list.");
        }
    }
}
///////////// with mode
public void Main(string argument) {
    // 1. Find the sorter block
    IMyConveyorSorter sorter = GridTerminalSystem.GetBlockWithName("My Sorter Name") as IMyConveyorSorter;
    if (sorter == null) return;

    // 2. CHANGE THE MODE HERE
    // Options: MyConveyorSorterMode.Whitelist or MyConveyorSorterMode.Blacklist
    sorter.Mode = MyConveyorSorterMode.Whitelist; 

    // 3. Get the filters and cargo inventory
    List<MyInventoryItemFilter> sorterFilters = new List<MyInventoryItemFilter>();
    sorter.GetFilterList(sorterFilters);
    
    IMyCargoContainer cargo = GridTerminalSystem.GetBlockWithName("My Cargo") as IMyCargoContainer;
    if (cargo == null) return;
    IMyInventory inventory = cargo.GetInventory();

    // 4. Compare items based on the NEW mode
    List<MyInventoryItem> cargoItems = new List<MyInventoryItem>();
    inventory.GetItems(cargoItems);

    foreach (var item in cargoItems) {
        bool isMatched = sorterFilters.Any(f => f.ItemId == item.Type);
        
        // Logic changes based on what the Mode is set to
        if (sorter.Mode == MyConveyorSorterMode.Whitelist) {
            Echo($"{item.Type.SubtypeId}: " + (isMatched ? "ALLOWED (Whitelisted)" : "BLOCKED"));
        } else {
            Echo($"{item.Type.SubtypeId}: " + (isMatched ? "BLOCKED (Blacklisted)" : "ALLOWED"));
        }
    }
}


